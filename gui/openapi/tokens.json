{
  "openapi": "3.0.3",
  "info": {
    "title": "Tokens",
    "version": "1.0.0",
    "description": "Conta tokens de um texto pt_BR e acrescenta a linha à janela recente."
  },
  "paths": {
    "/tokens": {
      "post": {
        "summary": "Enviar texto",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["texto"],
                "properties": {
                  "texto": {
                    "type": "string",
                    "description": "Frase em português. O tokenizer DistilBERT pt_BR devolve n_tokens."
                  }
                }
              },
              "example": { "texto": "O pedido chegou atrasado." }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pedido gravado e relatório recalculado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pedido": { "type": "object" },
                    "relatorio": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
